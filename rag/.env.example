# Paste an API key locally; never commit .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION=netguard_knowledge_v1
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional absolute paths (defaults are rag/data and rag/knowledge):
# RAG_DATA_DIR=
# RAG_KNOWLEDGE_DIR=
